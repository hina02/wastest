{
  "nodeModulesDir": "auto",

  "tasks": {
    "dev": "deno task dev:vite",
    "dev:vite": "deno run -A npm:vite",
    "build": {
      "command": "deno run -A npm:vite build",
      "description": "Build the project after running the pre-build script",
      "dependencies": ["prebuild"]
    }
  },
  "imports": {
    "$features/": "./src/features/",
    "$components/": "./src/components/",
    "$pages/": "./src/pages/",
    "$lib/": "./src/lib/",
    "$schemas/": "./src/schemas/",
    "@solidjs/router": "npm:@solidjs/router@^0.15.2",
    "@std/log": "jsr:@std/log@^0.224.12",
    "rollup-plugin-visualizer": "npm:rollup-plugin-visualizer@^6.0.5",
    "solid-js": "npm:solid-js@^1.9.10",
    "tailwindcss": "npm:tailwindcss@^4.1.17",
    "@tailwindcss/vite": "npm:@tailwindcss/vite@^4.1.17",
    "vite": "npm:vite@^7.2.6",
    "vite-plugin-solid": "npm:vite-plugin-solid@^2.11.10"
  },
  "compilerOptions": {
    "jsx": "react-jsx",
    "jsxImportSource": "solid-js",
    "lib": ["dom", "dom.iterable", "dom.asynciterable", "deno.ns"]
  },
  "fmt": {
    "exclude": [".github/workflows"]
  }
}
